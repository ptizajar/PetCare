<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #F1FFE0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.AddAnimal">
   <children>
      <Pane layoutX="207.0" layoutY="73.0" prefHeight="121.0" prefWidth="185.0" style="-fx-border-color: #000000;">
         <children>
            <ImageView fx:id="AddPetPhotoField" fitHeight="121.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </Pane>
      <Text layoutX="227.0" layoutY="55.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Добавление питомца">
         <font>
            <Font name="Calibri" size="16.0" />
         </font>
      </Text>
      <TextField fx:id="addPetName" layoutX="155.0" layoutY="238.0" prefHeight="25.0" prefWidth="289.0" promptText="Имя" />
      <TextField fx:id="addPetType" layoutX="155.0" layoutY="274.0" prefHeight="25.0" prefWidth="289.0" promptText="Вид" />
      <TextField fx:id="addPetColor" layoutX="155.0" layoutY="348.0" prefHeight="25.0" prefWidth="289.0" promptText="Окрас" />
      <ComboBox fx:id="addPetBreed" layoutX="155.0" layoutY="310.0" prefHeight="25.0" prefWidth="289.0" promptText="Порода" />
      <TextField fx:id="addPetVaccinations" layoutX="155.0" layoutY="456.0" prefHeight="25.0" prefWidth="289.0" promptText="Прививки (перечислите через запятую)" />
      <Button fx:id="addPetOkButton" layoutX="155.0" layoutY="520.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="289.0" style="-fx-background-color: #F9E4D1;" text="ОК" />
      <DatePicker fx:id="addPetDateBorn" layoutX="153.0" layoutY="384.0" prefHeight="25.0" prefWidth="289.0" promptText="Дата рождения" />
      <DatePicker fx:id="addPetDateVet" layoutX="153.0" layoutY="418.0" prefHeight="25.0" prefWidth="289.0" promptText="Дата визита к ветеринару" />
      <Button fx:id="addPetPhotoButton" layoutX="155.0" layoutY="204.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="289.0" style="-fx-background-color: #F9E4D1;" text="Добавить фото" />
   </children>
</AnchorPane>
